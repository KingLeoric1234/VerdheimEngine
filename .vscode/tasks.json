{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build engine",
            "type": "shell",
            "command": "gcc",
            "args": [
                "Engine/EntryPoint/EntryPoint.c",
                "Engine/FrameUpdate/FrameUpdate.c",
                "Engine/InitializeCheck/InitializeCheck.c",
                "-o", "engine.exe",
                "-Wall"
            ],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
